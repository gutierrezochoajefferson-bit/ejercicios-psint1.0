Algoritmo ejercicio
	
	Definir num1, num2, num3, num4, suma, promedio Como Real
	
	Escribir "ingrese sus 4 numeros"
	leer num1, num2, num3, num4
	
	suma <- num1+ num2+ num3+ num4
	promedio <- suma/4
	
	Escribir "la suma de sus numeros es: " suma
	
	Escribir "el promedio de sus numeros es: " promedio
	

FinAlgoritmo
